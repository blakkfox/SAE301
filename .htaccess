# ---------------------------------------------------------------------------
# Aiguillage principal du projet.
#
# Le projet est déposé dans un espace web personnel et accessible à
# https://mmi.unilim.fr/~votre_login/Base/
# Ce fichier décide, pour chaque requête, si elle relève du back (l'API) ou
# du front (le résultat de npm run build, dans front/dist/).
# ---------------------------------------------------------------------------

# Pas de listing de dossier si un index est absent.
Options -Indexes

RewriteEngine On

# 1. Toute requête /api/... est confiée au back (l'API JSON).
#    QSA conserve la chaîne de requête (?page=2), END arrête la réécriture.
RewriteRule ^api/ back/index.php [END,QSA]

# 3. (second passage, voir la règle 2) La requête désigne désormais un chemin
#    dans front/dist/. Si c'est un fichier du build (script, feuille de style,
#    image), on le sert tel quel.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^front/dist/ - [END]

#    Photo produit téléversée depuis le back-office (US GOF-a) après le
#    dernier build : PHP l'enregistre dans front/public/images/produits/, que
#    npm run build recopie dans front/dist/. En attendant, elle est servie
#    depuis front/public/ — ce dossier ne reçoit que des images réencodées.
RewriteCond %{REQUEST_FILENAME} ^(.+)/front/dist/images/produits/([^/]+)$
RewriteCond %1/front/public/images/produits/%2 -f
RewriteRule ^front/dist/images/produits/([^/]+)$ front/public/images/produits/$1 [END]

#    Sinon, c'est une adresse de l'application (/admin, /films/12…) : seul le
#    routeur du front la connaît. On sert la page d'entrée, et le routeur
#    affichera la bonne page — ou la page 404.
RewriteRule ^front/dist/ front/dist/index.html [END]

# 2. Tout le reste est cherché dans front/dist/. Le drapeau L (et non END)
#    relance un passage dans ce fichier avec le chemin réécrit : c'est alors
#    la règle 3 qui s'applique, et elle peut tester si le fichier existe.
#    Les sources (front/src/…) et la configuration du back ne sont donc
#    jamais servies : /front/src/main.js devient front/dist/front/src/main.js,
#    qui n'existe pas.
RewriteRule ^(.*)$ front/dist/$1 [L]
